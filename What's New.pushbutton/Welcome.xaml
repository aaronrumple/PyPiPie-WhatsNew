<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New"
        Height="380" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">

    <Border CornerRadius="15" Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="2">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="LogoImage"
                       Width="120"
                       Height="120"
                       Stretch="Uniform"
                       Margin="0,15,0,5"/>

                <TextBlock Text="PyPiPie Factory Tools"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>

                <TextBlock Text="Building What's New..."
                           Foreground="#A0A0A0"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="StatusText"
                           Text="Starting..."
                           Foreground="#D8D8D8"
                           FontSize="13"
                           Width="350"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <ProgressBar x:Name="LoadProgress"
                             IsIndeterminate="False"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Width="350"
                             Height="10"
                             Background="#3E3E42"
                             Foreground="#007ACC"
                             BorderThickness="0"/>

                <TextBlock x:Name="PercentText"
                           Text="0%"
                           Foreground="#A0A0A0"
                           FontSize="12"
                           Width="350"
                           TextAlignment="Right"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
